# Clockodo-Zugangsdaten. Kopie als .env anlegen und ausfuellen (.env ist gitignored).
#
# Die Clockodo-API verlangt drei Header:
#   X-ClockodoApiUser               -> CLOCKODO_API_USER
#   X-ClockodoApiKey                -> CLOCKODO_API_KEY
#   X-Clockodo-External-Application -> "CLOCKODO_APP_NAME;CLOCKODO_APP_EMAIL"
#
# Achtung: Name und E-Mail der Anwendung duerfen zusammen mit dem Semikolon
# maximal 50 Zeichen lang sein.

# E-Mail-Adresse des Clockodo-Benutzers, dem der API-Key gehoert.
CLOCKODO_API_USER=vorname.nachname@example.com

# API-Key aus Clockodo, Menuepunkt "Persoenliche Daten".
CLOCKODO_API_KEY=your_api_key_here

# Kennzeichnung der aufrufenden Anwendung gegenueber Clockodo.
CLOCKODO_APP_NAME=Umsatzprognose
CLOCKODO_APP_EMAIL=vorname.nachname@example.com

# Zugangsdaten fuer die Bausteine Schulungsanmeldungen und Kosten (Google Sheets) -
# beide nutzen dieselben Zugangsdaten und dieselbe jaehrliche Datei, nur
# unterschiedliche Tabellenblaetter darin.
#
# Kein Service-Account: fuer diese Anlage gibt Google nur eine OAuth-Client-ID aus. In
# der Google-Cloud-Konsole die Google-Sheets-API aktivieren und unter "Anmeldedaten"
# eine OAuth-Client-ID vom Typ "Desktopanwendung" anlegen; die heruntergeladene
# JSON-Datei ist GOOGLE_OAUTH_CLIENT_JSON unten. Diese Variable wird **nur lokal**
# gebraucht - in Colab meldet sich die aufrufende Person stattdessen mit ihrem eigenen
# Google-Konto an und braucht dafuer selbst Lesezugriff auf die betreffenden Sheets.
# Lokal oeffnet der erste Aufruf einen Browser-Tab zum Anmelden; danach liegt ein
# Token in .google_oauth_token.json (gitignored) und der Login entfaellt.

# Das OAuth-Client-JSON (Datei aus der Google-Cloud-Konsole, Anwendungstyp
# "Desktopanwendung") als einzeiliger JSON-String. Nur lokal noetig, siehe oben.
GOOGLE_OAUTH_CLIENT_JSON={"installed": {"client_id": "...", "client_secret": "...", "...": "..."}}

# Jahr -> Spreadsheet-ID, als JSON-Objekt. Eine Datei je Jahr, mit den Tabellenblaettern
# fuer Schulungsplanung ("Oeffentliche Schulungen") und Kostenprognose
# ("Kosten <Jahr>"). Die ID steht im Google-Sheets-Link zwischen "/d/" und "/edit".
TRAINING_SHEET_ID={"2026": "spreadsheet_id_2026", "2027": "spreadsheet_id_2027"}
