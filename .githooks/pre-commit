#!/usr/bin/env python3
"""Pre-commit-Hook: entfernt Zellausgaben aus committeten Notebooks.

Verhindert, dass aus Clockodo oder den Schulungs-Sheets gelesene Werte über
Diagramme oder Tabellen als Zellausgabe ins öffentliche Repository gelangen - siehe
CLAUDE.md, Abschnitt "Keine gelesenen Werte im Repository". Reine Standardbibliothek,
kein zusätzliches Paket nötig - der Hook muss auch ohne `uv sync --extra notebook`
laufen.

Findet der Hook Zellausgaben in einem staged Notebook, entfernt er sie, staged die
bereinigte Datei erneut und bricht den Commit ab (Exit-Code 1) - damit die Änderung
sichtbar bleibt, statt sie unbemerkt unter den Ursprungsstand zu schieben.
`git commit` erneut ausführen, dann ist die Datei bereits bereinigt.

Einmalig pro Klon aktivieren: `git config core.hooksPath .githooks`
"""

from __future__ import annotations

import json
import subprocess
import sys


def staged_notebooks() -> list[str]:
    ergebnis = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True,
        text=True,
        check=True,
    )
    return [zeile for zeile in ergebnis.stdout.splitlines() if zeile.endswith(".ipynb")]


def zellausgaben_entfernen(pfad: str) -> bool:
    """Entfernt Ausgaben und Ausführungszähler aus einer Notebook-Datei.

    Returns:
        Ob die Datei dabei verändert wurde.
    """
    with open(pfad, encoding="utf-8") as datei:
        notebook = json.load(datei)

    veraendert = False
    for zelle in notebook.get("cells", []):
        if zelle.get("cell_type") != "code":
            continue
        if zelle.get("outputs"):
            zelle["outputs"] = []
            veraendert = True
        if zelle.get("execution_count") is not None:
            zelle["execution_count"] = None
            veraendert = True
        # Manche Jupyter-Versionen haengen hier Ausfuehrungszeiten an - kein Wert
        # fuers Repository, siehe Moduldocstring.
        if zelle.get("metadata", {}).pop("execution", None) is not None:
            veraendert = True

    if veraendert:
        with open(pfad, "w", encoding="utf-8") as datei:
            json.dump(notebook, datei, indent=1, ensure_ascii=False)
            datei.write("\n")

    return veraendert


def main() -> int:
    notebooks = staged_notebooks()
    if not notebooks:
        return 0

    bereinigt = []
    for pfad in notebooks:
        try:
            if zellausgaben_entfernen(pfad):
                bereinigt.append(pfad)
        except (OSError, json.JSONDecodeError) as fehler:
            print(f"pre-commit: {pfad} konnte nicht geprüft werden ({fehler})", file=sys.stderr)
            return 1

    if not bereinigt:
        return 0

    subprocess.run(["git", "add", *bereinigt], check=True)
    print(
        "pre-commit: Zellausgaben entfernt aus: "
        + ", ".join(bereinigt)
        + "\nDatei(en) sind bereits neu gestaged - `git commit` einfach erneut ausführen.",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
