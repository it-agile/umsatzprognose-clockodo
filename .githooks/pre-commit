#!/usr/bin/env python3
"""Pre-commit-Hook: entfernt Zellausgaben aus committeten Notebooks und formatiert
staged Python-Dateien mit ``ruff format``.

Der Notebook-Teil verhindert, dass aus Clockodo oder den Schulungs-Sheets gelesene
Werte über Diagramme oder Tabellen als Zellausgabe ins öffentliche Repository
gelangen - siehe CLAUDE.md, Abschnitt "Keine gelesenen Werte im Repository". Er ist
reine Standardbibliothek, kein zusätzliches Paket nötig - dieser Teil muss auch ohne
`uv sync --extra notebook` laufen. Der Formatierungs-Teil braucht dagegen `ruff`
(`uv sync --extra ruff` bzw. `--extra dev`) und ruft es ueber `uv run` auf, statt ein
lokal aktiviertes venv vorauszusetzen - ein Git-Hook laeuft nicht zwangslaeufig mit
aktiviertem venv im PATH, `uv run` findet die Projektumgebung trotzdem ueber
`pyproject.toml`/`uv.lock`.

Findet der Hook Zellausgaben in einem staged Notebook oder formatiert `ruff format`
eine staged Python-Datei um, entfernt/formatiert er sie, staged die veraenderte Datei
erneut und bricht den Commit ab (Exit-Code 1) - damit die Änderung sichtbar bleibt,
statt sie unbemerkt unter den Ursprungsstand zu schieben. `git commit` erneut
ausführen, dann ist die Datei bereits bereinigt/formatiert.

Einmalig pro Klon aktivieren: `git config core.hooksPath .githooks`
"""

from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "scripts"))
from notebook_ausgaben import zellausgaben_entfernen


def staged_dateien(*, suffix: str) -> list[str]:
    ergebnis = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True,
        text=True,
        check=True,
    )
    return [zeile for zeile in ergebnis.stdout.splitlines() if zeile.endswith(suffix)]


def python_dateien_formatieren(dateien: list[str]) -> list[str]:
    """Formatiert `dateien` mit `ruff format`, gibt die tatsaechlich veraenderten
    zurueck - ein Vorher/Nachher-Vergleich, weil `ruff format` selbst nicht meldet,
    welche Dateien es angefasst hat."""
    vorhandene = [pfad for pfad in dateien if Path(pfad).exists()]
    if not vorhandene:
        return []
    vorher = {pfad: Path(pfad).read_bytes() for pfad in vorhandene}
    subprocess.run(["uv", "run", "ruff", "format", *vorhandene], check=True)
    return [pfad for pfad, alt in vorher.items() if Path(pfad).read_bytes() != alt]


def main() -> int:
    abbrechen = False

    notebooks = staged_dateien(suffix=".ipynb")
    bereinigt = []
    for pfad in notebooks:
        try:
            if zellausgaben_entfernen(Path(pfad)):
                bereinigt.append(pfad)
        except (OSError, json.JSONDecodeError) as fehler:
            print(f"pre-commit: {pfad} konnte nicht geprüft werden ({fehler})", file=sys.stderr)
            return 1
    if bereinigt:
        subprocess.run(["git", "add", *bereinigt], check=True)
        print(
            "pre-commit: Zellausgaben entfernt aus: "
            + ", ".join(bereinigt)
            + "\nDatei(en) sind bereits neu gestaged - `git commit` einfach erneut ausführen.",
            file=sys.stderr,
        )
        abbrechen = True

    python_dateien = staged_dateien(suffix=".py")
    try:
        reformatiert = python_dateien_formatieren(python_dateien)
    except (OSError, subprocess.CalledProcessError) as fehler:
        print(
            f"pre-commit: ruff format konnte nicht ausgefuehrt werden ({fehler})", file=sys.stderr
        )
        return 1
    if reformatiert:
        subprocess.run(["git", "add", *reformatiert], check=True)
        print(
            "pre-commit: ruff format hat neu formatiert: "
            + ", ".join(reformatiert)
            + "\nDatei(en) sind bereits neu gestaged - `git commit` einfach erneut ausführen.",
            file=sys.stderr,
        )
        abbrechen = True

    return 1 if abbrechen else 0


if __name__ == "__main__":
    raise SystemExit(main())
