#!/usr/bin/env python3
"""Pre-commit-Hook: entfernt Zellausgaben aus committeten Notebooks, klappt ihre
Code-Zellen ein und formatiert staged Python-Dateien mit ``ruff format``.

Der Notebook-Teil verhindert, dass aus Clockodo oder den Schulungs-Sheets gelesene
Werte über Diagramme oder Tabellen als Zellausgabe ins öffentliche Repository
gelangen - siehe CLAUDE.md, Abschnitt "Keine gelesenen Werte im Repository". Dazu
gehört auch, dass jede Code-Zelle eingeklappt bleibt (``metadata.jupyter.
source_hidden``, siehe ``code_zellen_einklappen()`` in ``scripts/notebook_ausgaben.
py``) - Notebooks in diesem Repository zeigen Fachexpert:innen grundsätzlich keinen
Code, nur Zell-Titel und Ausgabe; eine neu eingefügte oder überschriebene Zelle ohne
diese Metadata würde ihren Code offen zeigen. Beide Prüfungen sind reine
Standardbibliothek, kein zusätzliches Paket nötig - dieser Teil muss auch ohne
`uv sync --extra notebook` laufen. Der Formatierungs-Teil braucht dagegen `ruff`
(`uv sync --extra ruff` bzw. `--extra dev`): steht es schon direkt auf PATH (etwa in
einem aktivierten venv oder einem tox-Environment, in dem dieser Hook-Teil selbst
getestet wird, siehe `[tool.tox.env.coverage]`), wird es direkt aufgerufen; sonst
faellt der Hook auf `uv run ruff` zurueck, das die Projektumgebung selbst ueber
`pyproject.toml`/`uv.lock` aufloest - fuer den Fall eines Git-Hooks ohne aktiviertes
venv im PATH. Ein zuerst versuchtes `uv run --active` (das genau dieselbe
Umgebungswahl adressieren soll) scheiterte an einer zu alten lokal installierten
uv-Version, die das Flag noch nicht kennt - der direkte PATH-Aufruf ist zudem
einfacher und ohne jede Versionsanforderung an `uv` selbst.

Findet der Hook Zellausgaben oder ausgeklappte Code-Zellen in einem staged Notebook,
oder formatiert `ruff format` eine staged Python-Datei um, bereinigt/formatiert er
sie, staged die veraenderte Datei erneut und bricht den Commit ab (Exit-Code 1) -
damit die Änderung sichtbar bleibt, statt sie unbemerkt unter den Ursprungsstand zu
schieben. `git commit` erneut ausführen, dann ist die Datei bereits
bereinigt/formatiert.

Einmalig pro Klon aktivieren: `git config core.hooksPath .githooks`
"""

from __future__ import annotations

import json
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "scripts"))
from notebook_ausgaben import code_zellen_einklappen, zellausgaben_entfernen


def staged_dateien(*, suffix: str) -> list[str]:
    ergebnis = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True,
        text=True,
        check=True,
    )
    return [zeile for zeile in ergebnis.stdout.splitlines() if zeile.endswith(suffix)]


def _ruff_befehl() -> list[str]:
    """`ruff` direkt, wenn es schon auf PATH steht (aktiviertes venv, tox-Environment
    dieses Hooks selbst) - sonst ueber `uv run`, das die Projektumgebung selbst ueber
    `pyproject.toml`/`uv.lock` aufloest (normaler Git-Hook ohne aktiviertes venv)."""
    return ["ruff"] if shutil.which("ruff") is not None else ["uv", "run", "ruff"]


def python_dateien_formatieren(dateien: list[str]) -> list[str]:
    """Formatiert `dateien` mit `ruff format`, gibt die tatsaechlich veraenderten
    zurueck - ein Vorher/Nachher-Vergleich, weil `ruff format` selbst nicht meldet,
    welche Dateien es angefasst hat."""
    vorhandene = [pfad for pfad in dateien if Path(pfad).exists()]
    if not vorhandene:
        return []
    vorher = {pfad: Path(pfad).read_bytes() for pfad in vorhandene}
    subprocess.run([*_ruff_befehl(), "format", *vorhandene], check=True)
    return [pfad for pfad, alt in vorher.items() if Path(pfad).read_bytes() != alt]


def main() -> int:
    abbrechen = False

    notebooks = staged_dateien(suffix=".ipynb")
    bereinigt = []
    for pfad in notebooks:
        try:
            # Beide Pruefungen laufen unabhaengig vom Kurzschluss von `or` - eine
            # veraenderte Zellausgabe soll das Einklappen nicht ueberspringen.
            ausgaben_entfernt = zellausgaben_entfernen(Path(pfad))
            eingeklappt = code_zellen_einklappen(Path(pfad))
        except (OSError, json.JSONDecodeError) as fehler:
            print(f"pre-commit: {pfad} konnte nicht geprüft werden ({fehler})", file=sys.stderr)
            return 1
        if ausgaben_entfernt or eingeklappt:
            bereinigt.append(pfad)
    if bereinigt:
        subprocess.run(["git", "add", *bereinigt], check=True)
        print(
            "pre-commit: Notebook(s) bereinigt (Zellausgaben entfernt und/oder "
            "Code-Zellen eingeklappt): "
            + ", ".join(bereinigt)
            + "\nDatei(en) sind bereits neu gestaged - `git commit` einfach erneut ausführen.",
            file=sys.stderr,
        )
        abbrechen = True

    python_dateien = staged_dateien(suffix=".py")
    try:
        reformatiert = python_dateien_formatieren(python_dateien)
    except (OSError, subprocess.CalledProcessError) as fehler:
        print(
            f"pre-commit: ruff format konnte nicht ausgefuehrt werden ({fehler})", file=sys.stderr
        )
        return 1
    if reformatiert:
        subprocess.run(["git", "add", *reformatiert], check=True)
        print(
            "pre-commit: ruff format hat neu formatiert: "
            + ", ".join(reformatiert)
            + "\nDatei(en) sind bereits neu gestaged - `git commit` einfach erneut ausführen.",
            file=sys.stderr,
        )
        abbrechen = True

    return 1 if abbrechen else 0


if __name__ == "__main__":
    raise SystemExit(main())
